# NASA API key — free at https://api.nasa.gov/
# Replace this placeholder before loading asteroid data.
NASA_API_KEY=your_nasa_api_key_here

# Legacy setting; the current Plotly UI does not require a Cesium token.
CESIUM_ION_TOKEN=

# Local Flask settings — open http://127.0.0.1:8080 after starting app.py
PORT=8080
FLASK_DEBUG=false
